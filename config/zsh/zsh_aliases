alias b='bat'
alias bathelp='bat --plain --language=help'
help() {
    "$@" --help 2>&1 | bathelp
}

mkcd() {
	mkdir -p "$1" && cd "$1"
}

function bt() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: bt <target_name>"
        return 1
    fi
    local target_name="$1"
    bazel test --test_output=streamed --test_timeout=5 --cache_test_results=no "${target_name}"
}

alias pc="cd \$(fd --type d | fzf)"
alias pp="cd \$(fd . '/home/wk/repositories/pennybot' --type d | fzf)"
